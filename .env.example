# Copia este archivo como .env (NUNCA subas el .env a GitHub)

# auto | simulado | openai
#   auto     -> usa OpenAI si hay OPENAI_API_KEY; si no, el modelo simulado
#   simulado -> fuerza el modelo simulado (demo sin costo)
AGENT_MODE=auto

# Opcional: con una key real el agente usa GPT en vez del simulado
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

APP_VERSION=1.0.0
